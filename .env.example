# Public site URL - used for metadata, sitemap.xml, and robots.txt.
NEXT_PUBLIC_SITE_URL=https://biotech.civitasholdings.co.za

# Afrihost PHP bridge (public/php). Leave unset locally to get a graceful
# "not connected yet, email us" response on every lead-capture form.
BIOTECH_BRIDGE_URL=https://biotech.civitasholdings.co.za/php/
BIOTECH_API_KEY=
BIOTECH_API_TIMEOUT_MS=10000

# The Next.js app calls the protected PHP health check at:
#   ${BIOTECH_BRIDGE_URL}/health.php
